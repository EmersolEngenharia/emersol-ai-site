# Copie este arquivo para FORA do docroot, por exemplo:
#   /var/www/vhosts/emersol.ai/private/.env
# Nunca coloque o .env dentro de httpdocs e nunca o commite.
# O PHP lê, nesta ordem: variáveis já definidas no servidor,
# o caminho em EMERSOL_ENV_FILE, ../private/.env e ../.env
# em relação ao docroot.

# Destino interno do e-mail. Pode ser diferente do e-mail público
# definido em src/config/site.ts. Obrigatório apenas se for usar SMTP.
CONTACT_TO=

# Entrega prevista: webhook do n8n (https://n8n.emersol.ai), fora do site.
# Somente https, exceto localhost para teste. Fica neste arquivo, nunca no bundle.
WEBHOOK_URL=
# Opcional. Se preenchido, contact.php envia o valor no cabeçalho
# X-Webhook-Secret. Se ficar vazio, esse cabeçalho não é enviado.
# No n8n, confira o mesmo valor antes de aceitar o pedido.
WEBHOOK_SECRET=

# SMTP opcional. Sem bibliotecas externas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls | ssl | none
SMTP_TLS=starttls

# Origens aceitas no POST do navegador, separadas por vírgula.
ALLOWED_ORIGINS=https://emersol.ai

# Turnstile é opcional e fica desligado se o segredo estiver vazio.
# A chave pública correspondente fica em src/config/site.ts (turnstileSiteKey).
TURNSTILE_SECRET=

# Antiabuso.
RATELIMIT_DIR=
RATELIMIT_SALT=
RATELIMIT_MAX=5
RATELIMIT_WINDOW=3600
MIN_SUBMIT_SECONDS=3

# Só ligue se o PHP receber o IP real em X-Forwarded-For
# reescrito pelo nginx/Plesk. Caso contrário deixe vazio.
TRUST_PROXY=
