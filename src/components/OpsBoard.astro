---
import type { Dictionary } from "../i18n/types";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const columns = [
  [dict.mock.cards[0], dict.mock.cards[1]],
  [dict.mock.cards[2]],
  [dict.mock.cards[3]],
];
---

<aside class="board" aria-hidden="true">
  <div class="board-top">
    <strong>{dict.mock.title}</strong>
    <span class="stamp">{dict.common.demo}</span>
  </div>
  <div class="cols">
    {dict.mock.columns.map((label, index) => (
      <div class="col">
        <h3>{label}</h3>
        {columns[index].map((card) => (
          <div class="ticket">
            <strong>{card.title}</strong>
            <span>{card.meta}</span>
          </div>
        ))}
      </div>
    ))}
  </div>
</aside>
